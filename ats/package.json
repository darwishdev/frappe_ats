{
  "name": "frappe-ui-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit &&  vite build --base=/assets/mawhub/ats2/ && yarn copy-html-entry",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "test": "vitest",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx",
    "type-check": "vue-tsc --noEmit",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "copy-html-entry": "cp ../mawhub/public/ats2/index.html ../mawhub/www/ats2.html"
  },
  "dependencies": {
    "feather-icons": "^4.29.2",
    "frappe-ui": "^0.1.192",
    "lucide-vue-next": "^0.562.0",
    "socket.io-client": "^4.7.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.7.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.5",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.4"
  }
}
